---
import Layout from '../layouts/Layout.astro';
import Placeholder from '../components/Placeholder.astro';
import CatIcon from '../components/CatIcon.astro';
import { cats } from '../data/cats';
---

<Layout
  title="Onze Ragdolls"
  description="Maak kennis met Coco en Zaza, onze twee Ragdolls en het hart van Cattery Pecinta Kucing."
>
  <!-- ── HEADER ─────────────────────────────────────────── -->
  <section class="relative overflow-hidden pt-16 pb-12">
    <div class="soft-blob bg-mint w-[420px] h-[420px] -top-20 -left-24"></div>
    <div class="container-soft relative max-w-3xl">
      <span class="eyebrow eyebrow-rose">Onze Ragdolls</span>
      <h1 class="mt-4 font-display text-4xl sm:text-5xl md:text-6xl">
        Coco &amp; <span class="italic text-turquoise-deep">Zaza</span>
      </h1>
      <p class="mt-6 text-lg">
        Twee Ragdolls uit hetzelfde nestje, geboren op 28 februari 2025. Ze zijn samen bij ons komen wonen op 5 juni en vullen elkaar perfect aan, rust en speelsheid, in één huis.
      </p>
    </div>
  </section>

  <!-- ── CATS ───────────────────────────────────────────── -->
  {cats.map((cat, idx) => (
    <section id={cat.slug} class={`py-20 ${idx % 2 === 0 ? '' : 'bg-cream-warm'} relative overflow-hidden`}>
      <div class="container-soft relative grid lg:grid-cols-12 gap-12 items-center">
        <div class:list={['lg:col-span-5 reveal', idx % 2 === 1 ? 'lg:order-2' : '']}>
          <Placeholder
            src={cat.image.src}
            alt={cat.image.alt}
            variant={idx % 2 === 0 ? 'mint' : 'blush'}
            ratio="4 / 5"
            rounded="28px"
            class="shadow-card"
          />
        </div>
        <div class="lg:col-span-7 reveal space-y-5">
          <div>
            <span class="eyebrow">{cat.role}</span>
            <h2 class="mt-3 font-display text-3xl sm:text-4xl md:text-5xl">{cat.name}</h2>
            <p class="mt-3 text-sm text-ink-mute italic">Geboren {cat.birth} · {cat.color}</p>
          </div>
          <div class="space-y-4 max-w-xl">
            {cat.body.map((p) => <p>{p}</p>)}
          </div>
          <div class="flex flex-wrap gap-2 pt-2">
            {cat.traits.map((t) => <span class="chip"><CatIcon name="paw" size={12} /> {t}</span>)}
          </div>
          {cat.pedigreeUrl && (
            <a
              href={cat.pedigreeUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 pt-2 text-rose-deep hover:text-rose transition-colors text-sm font-medium"
            >
              <CatIcon name="sparkle" size={14} />
              Bekijk de stamboom van {cat.name}
              <CatIcon name="arrow" size={14} />
            </a>
          )}
        </div>
      </div>
    </section>
  ))}

  <!-- ── CTA ────────────────────────────────────────────── -->
  <section class="py-24">
    <div class="container-soft">
      <div class="relative overflow-hidden rounded-[32px] bg-gradient-to-br from-blush via-rose to-rose-deep text-cream p-10 md:p-16 text-center">
        <div class="relative max-w-2xl mx-auto">
          <h2 class="font-display text-2xl sm:text-3xl md:text-5xl text-cream">
            Op zoek naar een <span class="italic">kitten</span> uit hun nestje?
          </h2>
          <p class="mt-5 text-cream/90 max-w-lg mx-auto">
            Het eerste nestje verwachten we in het komende seizoen. Laat het ons weten als je interesse hebt, dan houden we je op de hoogte.
          </p>
          <div class="mt-8 flex flex-wrap justify-center gap-3">
            <a href="/kittens" class="inline-flex items-center gap-2 bg-cream text-ink px-6 py-3 rounded-full font-medium hover:bg-cream/90 transition-colors">
              Naar de kittens-pagina
              <CatIcon name="arrow" size={14} />
            </a>
            <a href="/contact" class="inline-flex items-center gap-2 border border-cream/40 text-cream px-6 py-3 rounded-full font-medium hover:bg-cream/10 transition-colors">
              <CatIcon name="mail" size={16} />
              Neem contact op
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
