---
import Layout from '../layouts/Layout.astro';
import Placeholder from '../components/Placeholder.astro';
import CatIcon from '../components/CatIcon.astro';
import { site } from '../data/site';
import { litters } from '../data/litters';

const birthFormatter = new Intl.DateTimeFormat('nl-NL', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const includedItems = [
  { icon: 'sparkle', title: 'Officiële stamboom', text: 'Ieder kitten gaat met stamboom mee.' },
  { icon: 'heart', title: 'Vaccinaties', text: 'Volgens schema, met Europees paspoort.' },
  { icon: 'paw', title: 'Gechipt', text: 'Geregistreerd op naam.' },
  { icon: 'leaf', title: 'Ontwormd & ontvlooid', text: 'Volledig parasietvrij vóór vertrek.' },
  { icon: 'home', title: 'Vanaf 14 weken mee', text: 'Niet eerder, socialisatie heeft tijd nodig.' },
  { icon: 'eye', title: 'Gezondheidstest ouders', text: 'Onze poezen worden getest op erfelijke aandoeningen.' },
] as const;

const stappen = [
  {
    nr: '01',
    title: 'Een eerste kennismaking',
    body: 'Een mailtje of WhatsApp, vertel mij iets over jezelf en je situatie. Ik stel een paar vragen terug. Geen druk, gewoon kennismaken.',
  },
  {
    nr: '02',
    title: 'Op bezoek bij de cattery',
    body: 'Klikt het in een eerste contact? Dan nodig ik je uit om langs te komen, onze poezen te ontmoeten en alles te bespreken.',
  },
  {
    nr: '03',
    title: 'Reserveren',
    body: 'Bij een match en zodra het nestje er is, kun je een kitten reserveren. We bespreken samen welk kitten het beste bij je past.',
  },
  {
    nr: '04',
    title: 'Mee naar huis vanaf 14 weken',
    body: 'Op zijn vroegst rond 14 weken mag een kitten met je mee. Met Europees paspoort, eerste voer, een kittenpakket en wat tips voor de eerste dagen.',
  },
];
---

<Layout
  title="Kittens"
  description="Onze kittens groeien op in huis, gaan vanaf 14 weken naar hun nieuwe thuis en komen met stamboom, chip en vaccinaties."
>
  <!-- ── HEADER ─────────────────────────────────────────── -->
  <section class="relative overflow-hidden pt-16 pb-12">
    <div class="soft-blob bg-mint w-[420px] h-[420px] -top-20 -right-24"></div>
    <div class="soft-blob bg-blush w-[300px] h-[300px] top-32 -left-12"></div>
    <div class="container-soft relative max-w-3xl">
      <span class="eyebrow">Kittens</span>
      <h1 class="mt-4 font-display text-4xl sm:text-5xl md:text-6xl">
        Klaar voor hun <span class="italic text-rose-deep">nieuwe thuis</span>.
      </h1>
      <p class="mt-6 text-lg">
        Onze kittens groeien op bij ons in huis, tu  <!-- ── NESTJES ────────────────────────────────────────── -->
  {litters.map((litter) => {
    const [cover, ...more] = litter.photos;
    return (
      <section id={litter.slug} class="pb-16">
        <div class="container-soft">
          <div class="reveal relative overflow-hidden rounded-[28px] bg-cream-warm border border-line/60 p-6 md:p-10 grid lg:grid-cols-12 gap-8 lg:gap-12 items-center">
            {cover && (
              <div class="lg:col-span-5">
                <Placeholder
                  src={cover.src}
                  alt={cover.alt}
                  variant="blush"
                  ratio="4 / 5"
                  rounded="22px"
                  width={640}
                  loading="eager"
                  class="shadow-card max-w-sm mx-auto lg:max-w-none"
                />
              </div>
            )}
            <div class:list={[cover ? 'lg:col-span-7' : 'lg:col-span-12']}>
              <span class="chip-rose chip"><CatIcon name="heart" size={14} /> Nestje van {litter.mother}</span>
              <h2 class="mt-4 font-display text-2xl md:text-3xl">{litter.title}</h2>
              <p class="mt-2 text-sm text-ink-mute italic">
                Geboren op <time datetime={litter.born}>{birthFormatter.format(new Date(litter.born))}</time>
              </p>
              <p class="mt-4 max-w-xl">{litter.intro}</p>
              <p class="mt-3 max-w-xl">
                Wil je op de hoogte blijven van de planning? Stuur mij gerust een berichtje, dan hou ik je persoonlijk op de hoogte.
              </p>
              <a href="/contact" class="btn-primary mt-7">
                Houd me op de hoogte
                <CatIcon name="arrow" size={14} />
              </a>
            </div>
          </div>

          {more.length > 0 && (
            <div class="mt-5 grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
              {more.map((photo) => (
                <Placeholder
                  src={photo.src}
                  alt={photo.alt}
                  variant="cream"
                  ratio="1 / 1"
                  rounded="18px"
                  width={480}
                  class="reveal"
                />
              ))}
            </div>
          )}
        </div>
      </section>
    );
  })}

ce-nowrap">
            Houd me op de hoogte
            <CatIcon name="arrow" size={14} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── WAT KRIJG JE MEE ───────────────────────────────── -->
  <section class="py-20 bg-mint/40 paw-pattern">
    <div class="container-soft">
      <div class="max-w-2xl mb-12 reveal">
        <span class="eyebrow eyebrow-rose">Wat krijg je mee</span>
        <h2 class="mt-4 text-3xl md:text-4xl">
          Een goede start, <span class="italic text-turquoise-deep">van begin af aan</span>.
        </h2>
        <p class="mt-5">
          Ieder kitten verlaat ons huis met alles wat hij of zij nodig heeft voor een gezonde, rustige overgang naar het nieuwe thuis.
        </p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {includedItems.map((it) => (
          <div class="reveal bg-cream rounded-2xl p-6 border border-line/60">
            <span class="grid place-items-center w-11 h-11 rounded-full bg-blush text-rose-deep mb-4">
              <CatIcon name={it.icon} />
            </span>
            <h3 class="font-display text-xl">{it.title}</h3>
            <p class="mt-2 text-sm leading-relaxed">{it.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── STAPPEN ────────────────────────────────────────── -->
  <section class="py-24">
    <div class="container-soft">
      <div class="max-w-2xl mb-12 reveal">
        <span class="eyebrow">Hoe het werkt</span>
        <h2 class="mt-4 text-3xl md:text-4xl">
          In <span class="italic text-rose-deep">vier stappen</span> naar je kitten.
        </h2>
      </div>
      <div class="grid md:grid-cols-2 gap-5">
        {stappen.map((s) => (
          <div class="reveal bg-cream-warm rounded-2xl p-7 border border-line/40 flex gap-5">
            <span class="font-display text-3xl text-turquoise-deep leading-none shrink-0">{s.nr}</span>
            <div>
              <h3 class="font-display text-xl">{s.title}</h3>
              <p class="mt-2 text-sm leading-relaxed">{s.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CTA ────────────────────────────────────────────── -->
  <section class="pb-24">
    <div class="container-soft">
      <div class="relative overflow-hidden rounded-[32px] bg-gradient-to-br from-turquoise via-turquoise-deep to-teal text-cream p-10 md:p-16">
        <div class="soft-blob bg-cream/30 w-[280px] h-[280px] -top-20 -right-20"></div>
        <div class="relative">
          <h2 class="font-display text-2xl sm:text-3xl lg:text-4xl text-cream">
            Iets vragen of laten weten dat je <span class="italic">geïnteresseerd</span> bent?
          </h2>
          <p class="mt-5 text-cream/85">
            Ik reageer altijd persoonlijk. Mail of app, wat voor jou het prettigst is.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/contact" class="inline-flex items-center gap-2 bg-cream text-ink px-6 py-3 rounded-full font-medium hover:bg-cream/90 transition-colors">
              Neem contact op
              <CatIcon name="arrow" size={14} />
            </a>
            <a href={site.whatsappUrl} target="_blank" rel="noopener"
              class="inline-flex items-center gap-2 border border-cream/40 text-cream px-6 py-3 rounded-full font-medium hover:bg-cream/10 transition-colors">
              <CatIcon name="whatsapp" size={16} />
              WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
