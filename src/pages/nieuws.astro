---
import Layout from '../layouts/Layout.astro';
import CatIcon from '../components/CatIcon.astro';
import { news } from '../data/news';

const formatter = new Intl.DateTimeFormat('nl-NL', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<Layout
  title="Nieuws"
  description="Updates uit Cattery Pecinta Kucing — over Coco en Zaza, kittens, nestjes en alles wat we onderweg meemaken."
>
  <!-- ── HEADER ─────────────────────────────────────────── -->
  <section class="relative overflow-hidden pt-16 pb-12">
    <div class="soft-blob bg-mint w-[420px] h-[420px] -top-20 -left-24"></div>
    <div class="container-soft relative max-w-3xl">
      <span class="eyebrow">Nieuws</span>
      <h1 class="mt-4 font-display text-4xl sm:text-5xl md:text-6xl">
        Wat speelt er in <span class="italic text-rose-deep">de cattery</span>?
      </h1>
      <p class="mt-6 text-lg">
        Korte updates over Coco en Zaza, mijlpalen en — zodra het zover is — natuurlijk ook nieuws over de kittens.
      </p>
    </div>
  </section>

  <!-- ── TIMELINE ───────────────────────────────────────── -->
  <section class="pb-24">
    <div class="container-soft max-w-3xl">
      <ol class="relative border-l border-line/70 pl-6 space-y-10">
        {news.map((item) => (
          <li class="reveal relative">
            <span class="absolute -left-[31px] top-1 grid place-items-center w-5 h-5 rounded-full bg-rose text-cream">
              <CatIcon name="paw" size={11} />
            </span>
            <div class="bg-cream-warm rounded-2xl p-7 border border-line/40">
              <div class="flex flex-wrap items-center gap-3 text-xs text-ink-mute">
                <time datetime={item.date} class="uppercase tracking-[0.18em]">
                  {formatter.format(new Date(item.date))}
                </time>
                {item.tag && <span class="chip">{item.tag}</span>}
              </div>
              <h2 class="mt-3 font-display text-2xl">{item.title}</h2>
              <p class="mt-2 leading-relaxed">{item.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ── CTA ────────────────────────────────────────────── -->
  <section class="pb-24">
    <div class="container-soft">
      <div class="rounded-[28px] bg-cream-warm border border-line/60 p-10 md:p-12 text-center max-w-2xl mx-auto">
        <h2 class="font-display text-2xl md:text-3xl">
          Op de hoogte blijven van een <span class="italic text-rose-deep">nieuw nestje</span>?
        </h2>
        <p class="mt-3">
          Stuur ons een persoonlijk berichtje — dan houden we je actief op de hoogte zodra er nieuws is.
        </p>
        <a href="/contact" class="btn-primary mt-7">
          Houd me op de hoogte
          <CatIcon name="arrow" size={14} />
        </a>
      </div>
    </div>
  </section>
</Layout>
