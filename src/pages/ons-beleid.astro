---
import Layout from '../layouts/Layout.astro';
import CatIcon from '../components/CatIcon.astro';
import { policyIntro, policyPoints } from '../data/policy';
---

<Layout
  title="Ons beleid"
  description="Hoe wij onze cattery en het fokken benaderen, opgegroeid in huis, met stamboom, persoonlijk contact en levenslang betrokken."
>
  <!-- ── HEADER ─────────────────────────────────────────── -->
  <section class="relative overflow-hidden pt-16 pb-12">
    <div class="soft-blob bg-blush w-[420px] h-[420px] -top-20 -right-24"></div>
    <div class="container-soft relative max-w-3xl">
      <span class="eyebrow eyebrow-rose">Ons beleid</span>
      <h1 class="mt-4 font-display text-4xl sm:text-5xl md:text-6xl">
        Klein, persoonlijk en <span class="italic text-turquoise-deep">bewust</span>.
      </h1>
      <p class="mt-6 text-lg">{policyIntro}</p>
    </div>
  </section>

  <!-- ── PUNTEN ─────────────────────────────────────────── -->
  <section class="pb-20">
    <div class="container-soft">
      <div class="grid md:grid-cols-2 gap-5 max-w-5xl mx-auto">
        {policyPoints.map((p, i) => (
          <div class="reveal bg-cream-warm rounded-2xl p-7 border border-line/40 flex gap-5">
            <span class:list={[
              'shrink-0 grid place-items-center w-11 h-11 rounded-full',
              i % 2 === 0 ? 'bg-mint text-teal' : 'bg-blush text-rose-deep',
            ]}>
              <CatIcon name="paw" size={20} />
            </span>
            <div>
              <h2 class="font-display text-xl">{p.title}</h2>
              <p class="mt-2 text-sm leading-relaxed">{p.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── DOELGROEP ──────────────────────────────────────── -->
  <section class="py-20 bg-mint/40 paw-pattern">
    <div class="container-soft max-w-3xl">
      <div class="reveal">
        <span class="eyebrow">Voor wie</span>
        <h2 class="mt-4 text-3xl md:text-4xl">
          Geschikt voor wie écht <span class="italic text-rose-deep">tijd en aandacht</span> heeft.
        </h2>
        <div class="mt-6 space-y-4">
          <p>
            Onze kittens gaan naar mensen die er bewust voor kiezen om er een, of soms twee, in hun gezin op te nemen. Een Ragdoll is sociaal, dus zit het liefst niet de hele dag alleen.
          </p>
          <p>
            We werken met een minimumleeftijd van 16 jaar voor onze kopers. Niet als formaliteit, maar omdat een Ragdoll voor ons een keuze is voor 12 tot 15 jaar, geen impuls.
          </p>
          <p>
            Mocht het, om welke reden dan ook, onverhoopt niet werken in een nieuw thuis, dan denken we mee en zoeken we samen naar een goede oplossing. Onze poezen blijven welkom.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── CTA ────────────────────────────────────────────── -->
  <section class="py-24">
    <div class="container-soft text-center max-w-2xl mx-auto">
      <h2 class="font-display text-3xl md:text-4xl">
        Klinkt dit als een <span class="italic text-rose-deep">match</span>?
      </h2>
      <p class="mt-5">
        We gaan graag het gesprek aan. Stuur ons een berichtje of plan een kennismaking, dan voelen we het samen aan.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/contact" class="btn-primary">
          Neem contact op
          <CatIcon name="arrow" size={14} />
        </a>
        <a href="/kittens" class="btn-secondary">Naar de kittens</a>
      </div>
    </div>
  </section>
</Layout>
