---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  // Een lokale (geïmporteerde) afbeelding wordt via astro:assets geoptimaliseerd
  // en verkleind. Een string blijft de Unsplash-fallback voor plekken waar nog
  // geen eigen foto beschikbaar is.
  src: string | ImageMetadata;
  alt: string;
  ratio?: string;
  rounded?: string;
  variant?: 'mint' | 'blush' | 'shell' | 'cream';
  width?: number;
  loading?: 'eager' | 'lazy';
  position?: string;
  class?: string;
}

const {
  src,
  alt,
  ratio = '4 / 5',
  rounded = '24px',
  variant = 'mint',
  width = 1000,
  loading = 'lazy',
  position = 'center',
  class: className = '',
} = Astro.props;

const bg = {
  mint: 'var(--color-mint)',
  blush: 'var(--color-blush)',
  shell: 'var(--color-shell)',
  cream: 'var(--color-cream-warm)',
}[variant];

const isLocal = typeof src !== 'string';

// Unsplash-fallback: bouw automatisch een geoptimaliseerde URL.
const optimized =
  typeof src === 'string'
    ? src.includes('?')
      ? src
      : `${src}?w=${width}&q=80&auto=format&fit=crop`
    : '';
---

<div
  class={`relative overflow-hidden ${className}`}
  style={`aspect-ratio: ${ratio}; border-radius: ${rounded}; background-color: ${bg};`}
>
  {isLocal ? (
    <Image
      src={src as ImageMetadata}
      alt={alt}
      widths={[400, 700, width]}
      sizes={`(max-width: 640px) 100vw, ${width}px`}
      loading={loading}
      decoding="async"
      class="absolute inset-0 w-full h-full object-cover"
      style={`object-position: ${position};`}
    />
  ) : (
    <img
      src={optimized}
      alt={alt}
      loading={loading}
      decoding="async"
      class="absolute inset-0 w-full h-full object-cover"
      style={`object-position: ${position};`}
    />
  )}
</div>
