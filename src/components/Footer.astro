---
import CatIcon from './CatIcon.astro';
import { navItems, site, credentials } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="mt-32 bg-cream-warm border-t border-line/60 relative overflow-hidden">
  <div class="soft-blob bg-mint w-[320px] h-[320px] -top-32 -right-20 opacity-40"></div>
  <div class="soft-blob bg-blush w-[240px] h-[240px] bottom-0 -left-12 opacity-50"></div>

  <div class="container-soft relative py-16 grid gap-12 md:grid-cols-2 lg:grid-cols-4">
    <div>
      <div class="font-display text-2xl leading-tight">
        Cattery<br />
        <span class="italic text-rose-deep">Pecinta Kucing</span>
      </div>
      <p class="mt-4 text-sm leading-relaxed">
        Een kleinschalige Ragdoll-cattery uit Arnhem. Onze kittens groeien op in huis, met liefde en aandacht.
      </p>
      <div class="mt-5 flex flex-wrap gap-2">
        <a href={credentials.membership.url} target="_blank" rel="noopener noreferrer" class="chip hover:text-rose-deep transition-colors">
          <CatIcon name="sparkle" size={12} /> {credentials.membership.label}
        </a>
        <span class="chip">
          <CatIcon name="heart" size={12} /> {credentials.certification.label}
        </span>
      </div>
    </div>

    <div>
      <h4 class="font-display text-lg mb-4">Menu</h4>
      <ul class="space-y-2 text-sm">
        {navItems.map((i) => (
          <li><a href={i.href} class="text-ink-soft hover:text-rose-deep transition-colors">{i.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h4 class="font-display text-lg mb-4">Contact</h4>
      <address class="not-italic text-sm space-y-2 text-ink-soft">
        <div>
          <a href={site.whatsappUrl} target="_blank" rel="noopener" class="hover:text-rose-deep transition-colors">WhatsApp</a>
        </div>
        <div>
          <a href={`mailto:${site.email}`} class="hover:text-rose-deep transition-colors break-all">{site.email}</a>
        </div>
        <div class="pt-2 text-ink-mute">{site.hours}</div>
      </address>
    </div>

    <div>
      <h4 class="font-display text-lg mb-4">Even kennismaken?</h4>
      <p class="text-sm leading-relaxed">
        We nemen graag de tijd voor een persoonlijk gesprek voordat we tot een afspraak komen.
      </p>
      <a href="/contact" class="btn-primary mt-5 text-sm">
        Neem contact op
      </a>
    </div>
  </div>

  <div class="border-t border-line/60 relative">
    <div class="container-soft py-6 flex flex-col md:flex-row items-center justify-between gap-3 text-xs text-ink-mute">
      <div>© {year} {site.fullName}</div>
      <div class="flex flex-col md:flex-row items-center gap-4">
        <a
          href="https://i-quip.nl"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Website ontworpen en gebouwd door I-quip"
          class="iquip-credit group inline-flex items-center gap-3"
        >
          <span class="credit-label">Gebouwd door</span>
          <span class="credit-name">I-quip</span>
          <span class="credit-arrow" aria-hidden="true">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M7 17L17 7M17 7H8M17 7V16"/>
            </svg>
          </span>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .iquip-credit { text-decoration: none; color: inherit; position: relative; }
  .iquip-credit:focus-visible {
    outline: 2px solid #6366F1;
    outline-offset: 6px;
    border-radius: 2px;
  }
  .credit-label {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    opacity: 0.6;
    transition: opacity 500ms cubic-bezier(0.16, 1, 0.3, 1);
    color: var(--color-ink-mute);
  }
  .credit-name {
    font-family: var(--font-display, inherit);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-ink, #1a1a1a);
    opacity: 0.85;
    transition:
      opacity 500ms cubic-bezier(0.16, 1, 0.3, 1),
      color 500ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 500ms cubic-bezier(0.16, 1, 0.3, 1);
    transform-origin: left center;
  }
  .credit-arrow {
    display: inline-flex;
    align-items: center;
    color: #6366F1;
    opacity: 0;
    transform: translate(-6px, 2px);
    transition: all 500ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .iquip-credit:hover .credit-label { opacity: 0.95; }
  .iquip-credit:hover .credit-name {
    opacity: 1;
    color: #6366F1;
    transform: scale(1.03);
  }
  .iquip-credit:hover .credit-arrow {
    opacity: 1;
    transform: translate(0, 0);
  }
  @media (prefers-reduced-motion: reduce) {
    .credit-label, .credit-name, .credit-arrow { transition: opacity 200ms ease; }
    .iquip-credit:hover .credit-name { transform: none; }
  }
</style>
