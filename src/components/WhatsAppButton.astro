---
import { site } from '../data/site';
import CatIcon from './CatIcon.astro';
---

<a
  href={site.whatsappUrl}
  target="_blank"
  rel="noopener"
  aria-label={`WhatsApp, ${site.whatsapp}`}
  class="fixed bottom-5 right-5 sm:bottom-6 sm:right-6 z-30 grid place-items-center w-12 h-12 sm:w-14 sm:h-14 rounded-full bg-turquoise-deep text-cream shadow-card hover:bg-teal transition-colors"
>
  <CatIcon name="whatsapp" size={26} />
</a>
